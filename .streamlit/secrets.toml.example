# Generate a unique key with:
# py -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Add the generated value to .streamlit/secrets.toml or your deployment's secrets:
# UNISYNC_MASTER_KEY = "paste-generated-key-here"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "YOUR_GOOGLE_OAUTH_CLIENT_ID"
client_secret = "YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
